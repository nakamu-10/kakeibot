{
  "name": "line-kakeibo-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kakeibo --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute kakeibo --local --file=schema.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "richmenu": "node scripts/richmenu.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
